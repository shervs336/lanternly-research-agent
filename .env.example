# Copy to .env.local and fill in. Without the AI + search keys, the app shows sample reports only.

# Google AI Studio → Get API key (free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Tavily → API keys (free tier, 1,000 searches/month)
TAVILY_API_KEY=

# Optional: Jina Reader key for higher page-reading limits (works without one)
JINA_API_KEY=

# Supabase → Project Settings → API Keys (same project as before is fine)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The SECRET key (sb_secret_...). Server-only: never expose it to the browser.
SUPABASE_SECRET_KEY=
